{
  "name": "neoma",
  "version": "1.0.4",
  "description": "neoma \u2014 a lightweight, open-source, local-first research journal and linked-note application. Your knowledge, rooted locally.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "private": true,
  "author": "Iwan",
  "homepage": "https://github.com/infinitumio/neoma",
  "repository": {
    "type": "git",
