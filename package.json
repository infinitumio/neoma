    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.0",
